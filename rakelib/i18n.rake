# frozen_string_literal: true

# Message catalogue tasks, standing in for upstream's po/meson.build.
#
# Upstream's build extracts po/simple-scan.pot from the files listed in
# po/POTFILES.in, merges each po/<lang>.po against it, and compiles the
# result into $datadir/locale/<lang>/LC_MESSAGES/simple-scan.mo. Meson's
# i18n module does all three; here each one is a rake task.
#
# The catalogues themselves are upstream's, carried across verbatim, so the
# translations a user sees are the ones GNOME's translators wrote. Only the
# extraction side is this port's: the msgids come out of lib/*.rb instead of
# src/*.vala, and they are kept identical to upstream's so the catalogues
# keep matching.
#
# The desktop entry and the AppStream metadata are translated by the
# packager's tooling, which merges the catalogues into the .in files at
# install time; their msgids are already in every po/<lang>.po, so nothing
# here extracts them again.
#
# data/locale is committed rather than built on demand: the port is run from a
# checkout as often as from an installed gem, and an English-only window until
# someone remembers to run a task is worse than carrying the compiled files.
# `i18n:mo` regenerates them whenever po/ changes.
#
# Lives in rakelib/ rather than the Rakefile because the Rakefile is
# templated by kettle-jem and anything added to it is overwritten.

def i18n_domain = "simple-scan"

def i18n_po_dir = "po"

def i18n_pot_file = File.join(i18n_po_dir, "#{i18n_domain}.pot")

def i18n_locale_dir = File.join("data", "locale")

def i18n_sources = Dir.glob("lib/**/*.rb").sort

def i18n_locales = Dir.glob(File.join(i18n_po_dir, "*.po")).map { |path| File.basename(path, ".po") }.sort

namespace :i18n do
  desc "Extract translatable strings from lib into po/simple-scan.pot"
  task :pot do
    require "gettext/tools"

    File.write(
      File.join(i18n_po_dir, "POTFILES.in"),
      [
        "# List of source files containing translatable strings.",
        "# Regenerated by `rake i18n:pot`; kept sorted.",
        *i18n_sources,
        "",
      ].join("\n"),
    )
    GetText::Tools::XGetText.run(

      "--output",

      i18n_pot_file,
      "--package-name",

      i18n_domain,
      "--add-comments",
      *i18n_sources,

    )
    puts("wrote #{i18n_pot_file} from #{i18n_sources.length} files")
  end

  desc "Merge po/*.po against the current pot, keeping existing translations"
  task merge: :pot do
    require "gettext/tools"

    i18n_locales.each do |locale|
      GetText::Tools::MsgMerge.run(
        "--update", File.join(i18n_po_dir, "#{locale}.po"), i18n_pot_file,
      )
    end
    puts("merged #{i18n_locales.length} catalogues")
  end

  desc "Compile po/*.po into data/locale, where the app reads them"
  task :mo do
    require "fileutils"
    require "gettext/tools"

    i18n_locales.each do |locale|
      File.join(i18n_locale_dir, locale, "LC_MESSAGES").tap do |dir|
        FileUtils.mkdir_p(dir)
        GetText::Tools::MsgFmt.run(
          "--output", File.join(dir, "#{i18n_domain}.mo"), File.join(i18n_po_dir, "#{locale}.po"),
        )
      end
    end
    puts("compiled #{i18n_locales.length} catalogues into #{i18n_locale_dir}")
  end

  desc "Remove the compiled catalogues"
  task :clean do
    require "fileutils"

    FileUtils.rm_rf(i18n_locale_dir)
    puts("removed #{i18n_locale_dir}")
  end
end
